# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL (used for metadata, sitemap and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API Keys.
# Both values are browser-safe; data access is protected by Row Level Security.
# Leave both empty to run the public site without a backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets: never prefix with NEXT_PUBLIC_ ---

# Supabase secret key (or legacy service_role key). Bypasses RLS. Used only on the server to store
# validated website inquiries and to key the IP hash used for rate limiting.
# Without it, lead forms show a "not available" notice instead of a form.
SUPABASE_SECRET_KEY=

# --- Job Radar (server-only; all optional — each source/channel turns on when its keys are set) ---
# JSearch on RapidAPI: Google for Jobs data — Indeed, Dice, LinkedIn and employers' own career sites.
JSEARCH_RAPIDAPI_KEY=
# Adzuna job search API (developer.adzuna.com). Set both or neither.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Email alerts via Resend (resend.com). Set both or neither. The From address must be on a domain
# verified in Resend, e.g. MARKET_ALERTS_FROM="CoreTech Job Radar <radar@your-domain.com>"
RESEND_API_KEY=
MARKET_ALERTS_FROM=
# Optional Slack team alerts: Slack app → Incoming Webhooks → https://hooks.slack.com/services/...
SLACK_MARKET_WEBHOOK_URL=
# Shared secret for the scheduled scan (at least 32 random characters). Vercel Cron sends it automatically.
CRON_SECRET=

# --- AI resume parsing (server-only; OFF until all of the first three are set) ---
# Set to true ONLY after completing the privacy & security review in README → "AI resume parsing".
AI_PRIVACY_REVIEW_APPROVED=
OPENAI_API_KEY=
# The OpenAI model to use (must support structured outputs). No default is assumed.
OPENAI_MODEL=
# Limits (optional): requests per person per hour, per organization per month, and total tokens per month.
AI_HOURLY_LIMIT=10
AI_MONTHLY_PARSE_LIMIT=200
AI_MONTHLY_TOKEN_BUDGET=
# Characters of resume text sent per request, after contact details are removed.
AI_MAX_INPUT_CHARS=24000

# --- Android app (Play Store, Trusted Web Activity) — public values, optional ---
# Published at /.well-known/assetlinks.json so Android trusts the app to open this site full-screen.
# Package name you chose in Bubblewrap/PWABuilder, and the SHA-256 fingerprint(s) of the signing key
# (Play Console → App integrity → App signing). Leave empty until the Android app exists.
ANDROID_TWA_PACKAGE_NAME=
ANDROID_TWA_SHA256_FINGERPRINTS=
